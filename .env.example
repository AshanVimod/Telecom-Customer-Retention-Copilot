# Copy this file to .env and fill in your own values. Never commit .env.

# Azure OpenAI models (AI resource)
AZURE_OPENAI_ENDPOINT=https://<your-ai-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Search
SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
SEARCH_KEY=

# Translator
TRANSLATOR_KEY=
TRANSLATOR_REGION=koreacentral

# Churn endpoint (key changes each time the endpoint is recreated)
CHURN_ENDPOINT_URL=https://<your-endpoint>.koreacentral.inference.ml.azure.com/score
CHURN_ENDPOINT_KEY=
